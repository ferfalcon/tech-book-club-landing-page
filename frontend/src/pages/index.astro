---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ReadTogether from '../components/ReadTogether.astro';
import Community from '../components/Community.astro';
import ReadingJourney from '../components/ReadingJourney.astro';
import MembershipOptions from '../components/MembershipOptions.astro';
import Testimonial from '../components/Testimonial.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Tech Book Club | Read, learn, connect">
	<main id="main-content" class="page-stack">
		<Hero />
		<ReadTogether />
		<Community />
		<ReadingJourney />
		<MembershipOptions />
		<Testimonial />
	</main>
	<Footer />
</Layout>
