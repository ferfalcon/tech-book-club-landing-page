---
import ButtonLink from './ButtonLink.astro';
import SocialProof from './SocialProof.astro';
import blueskyUrl from '../assets/tech-book-club/images/logo-bluesky.svg?url';
import linkedinUrl from '../assets/tech-book-club/images/logo-linkedin.svg?url';
---

<footer class="site-footer">
	<div class="site-footer__main">
		<h2>Ready to debug your reading list?</h2>
		<div class="site-footer__cta">
			<ButtonLink href="#membership-options" label="REVIEW MEMBERSHIP OPTIONS" variant="alternate" icon="up" />
			<SocialProof context="footer" />
		</div>
	</div>
	<div class="site-footer__bottom">
		<p>© 2024 – Tech Book Club</p>
		<nav class="social-links" aria-label="Social media">
			<a href="#" aria-label="Tech Book Club on Bluesky"><img src={blueskyUrl} alt="" width="22" height="22" /></a>
			<a href="#" aria-label="Tech Book Club on LinkedIn"><img src={linkedinUrl} alt="" width="22" height="22" /></a>
		</nav>
	</div>
</footer>
